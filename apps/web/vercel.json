{
  "routes": [
    {
      "src": "^/(.+)\\.md$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, User-Agent",
        "X-Robots-Tag": "noindex"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "headers": {
        "Vary": "Accept, User-Agent",
        "Link": "</index.md>; rel=\"alternate\"; type=\"text/markdown\""
      },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "accept",
          "value": "^.*text/markdown\\s*;[^,]*q\\s*=\\s*0(\\.0*)?\\s*([,;].*)?$"
        }
      ],
      "dest": "/index.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, User-Agent",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(ChatGPT-User|chatgpt-user|OAI-SearchBot|oai-searchbot|GPTBot|gptbot|Claude-User|claude-user|Claude-SearchBot|claude-searchbot|ClaudeBot|claudebot|Claude-Web|claude-web|Anthropic-ai|anthropic-ai|Perplexity-User|perplexity-user|PerplexityBot|perplexitybot|MistralAI-User|mistralai-user|GoogleOther|googleother|Applebot-Extended|applebot-extended|Meta-ExternalAgent|meta-externalagent|Meta-ExternalFetcher|meta-externalfetcher|DuckAssistBot|duckassistbot|YouBot|youbot|cohere-ai|Amazonbot|amazonbot|Bytespider|bytespider|CCBot|ccbot|Diffbot|diffbot|ImagesiftBot|imagesiftbot|Omgilibot|omgilibot).*"
        }
      ],
      "dest": "/index.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, User-Agent",
        "X-Robots-Tag": "noindex"
      }
    }
  ]
}
